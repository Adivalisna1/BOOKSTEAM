# ============================================================
# ROOT .gitignore — BookSteam Project
# ============================================================

# ─── Private / Local-only files (JANGAN DI-PUSH!) ────────
README.dev.md
task.md

# ─── Environment Variables (JANGAN DI-PUSH KE GITHUB!) ───
.env
.env.local
.env.development
.env.production
.env.test
.env*.local
*.env

# ─── Dependencies ────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Build Output ────────────────────────────────────────
/build
/dist
/out
.next/
**/.next/

# ─── Database / Data Files ───────────────────────────────
*.sqlite
*.sqlite3
*.db

# ─── Logs ────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS Files ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor / IDE ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Docker ──────────────────────────────────────────────
