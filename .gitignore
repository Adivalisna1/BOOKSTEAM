docker-compose.override.yml

# ─── TypeScript ──────────────────────────────────────────
*.tsbuildinfo

# ─── Vercel / Deployment ─────────────────────────────────
.vercel

# ─── Misc ────────────────────────────────────────────────
*.pem
/coverage
